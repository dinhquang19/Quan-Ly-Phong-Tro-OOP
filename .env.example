# Database connection used by the application and docker compose
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/quan_ly_phong_tro?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=qlytro
DB_PASSWORD=local_qlytro_password
MYSQL_ROOT_PASSWORD=local_mysql_root_password

# Local development account (change before using real data)
APP_ADMIN_INITIAL_PASSWORD=admin@123
APP_CONTACT_PHONE=
APP_UPLOAD_DIR=uploads

# Optional VietQR settings
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
