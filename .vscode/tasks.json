{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: run Spring Boot",
            "type": "shell",
            "command": "./mvnw",
            "windows": {
                "command": ".\\mvnw.cmd"
            },
            "args": ["spring-boot:run"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Maven: compile",
            "type": "shell",
            "command": "./mvnw",
            "windows": {
                "command": ".\\mvnw.cmd"
            },
            "args": ["-DskipTests", "compile"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
